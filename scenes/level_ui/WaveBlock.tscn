[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/level_ui/WaveBlock.gd" id="1_block"]

[node name="WaveBlock" type="VBoxContainer"]
size_flags_horizontal = 3
theme_override_constants/separation = 2
script = ExtResource("1_block")

[node name="TitlePanel" type="PanelContainer" parent="."]
unique_name_in_owner = true
layout_mode = 2

[node name="TitleLabel" type="Label" parent="TitlePanel"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 8
horizontal_alignment = 1
clip_text = true

[node name="Cells" type="GridContainer" parent="."]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 4
theme_override_constants/h_separation = 4
theme_override_constants/v_separation = 4
columns = 2
